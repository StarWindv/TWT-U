{
	"schemaVersion": 1,
	"id": "twt-u",
	"version": "${version}",
	"name": "Thirst Was Taken - Unofficial Edition",
	"description": "A thirst mod for Minecraft, ported from Forge to Fabric.",
	"authors": [
		"星灿长风v"
	],
	"contact": {
		"homepage": "https://github.com/StarWindv/TWT-U"
	},
	"license": "MIT",
	"icon": "assets/twt-u/icon-u-lite.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"twtu.TWTU"
		],
		"client": [
			"twtu.client.TWTUClient"
		]
	},
	"mixins": [
		"twt-u.mixins.json",
		{
			"config": "twt-u.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": "~1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"appleskin": "*"
	}
}
